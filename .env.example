# Copy these values into your local .env file. Never commit the real .env file.

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_WORKSHEET_NAME=sheet_name
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# --- Sender identity (used by process_ready_leads.py / Chunk 4) ---
# These are written into every cold email — set them once here.
SENDER_NAME=Your Full Name
SENDER_COMPANY_NAME=Your Company Name
SENDER_COMPANY_PROFILE=One or two sentences describing what your company does
SENDER_SERVICES=List each service you offer, one per line or comma-separated

# --- FastAPI backend (backend/api.py) ---
# Run with: uvicorn backend.api:app --reload --port 8000
# The API reads the same Google Sheets vars above — no extra config needed.
